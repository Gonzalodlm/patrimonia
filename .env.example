# Copiá este archivo como .env.local para probar en tu computadora. En Vercel, cargá cada variable
# en Settings → Environment Variables. Ninguna es obligatoria: sin ellas la web funciona con
# plantillas y sin guardar mails.

# Gemini API (plan gratuito de Google AI Studio). Sin clave, los textos salen de plantillas.
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-3.5-flash-lite
GEMINI_MODELO=

# Neon Postgres, para guardar los mails del aviso anual.
DATABASE_URL=
# Una frase larga y secreta para firmar los enlaces de baja. No la cambies después de mandar mails.
SECRETO_BAJAS=
# Dirección pública del sitio, para los enlaces de baja.
SITIO_URL=https://patrimonia.uy

# Supuestos reales de J.P. Morgan codificados en base64 (ver README). Solo en Vercel.
SUPUESTOS_JSON_BASE64=
